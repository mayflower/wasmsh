# Single source of truth for Pyodide build version pins.
# All build scripts must source this file.
#
# Bumping PYODIDE_VERSION also means refreshing the tracked files in
# packages/npm/wasmsh-pyodide/assets/ (pyodide-lock.json and the micropip,
# packaging and sqlite3 wheels) from the new CDN release:
# package-runtime-assets.mjs deliberately keeps those over a fresh build,
# so a stale lockfile makes the runtime request wheel names the new CDN
# release no longer serves.
PYODIDE_VERSION=0.29.5
EMSCRIPTEN_VERSION=4.0.9
